{
  "name": "juice-shop-ui-tests",
  "version": "1.0.0",
  "description": "Playwright UI tests for OWASP Juice Shop",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,mjs}": [
      "prettier --check"
    ]
  },
  "keywords": [],
  "author": "mikitatamilovich",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9"
  }
}
